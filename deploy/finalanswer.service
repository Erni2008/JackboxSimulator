[Unit]
Description=Final Answer multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finalanswer
Group=finalanswer
WorkingDirectory=/opt/finalanswer
EnvironmentFile=/etc/finalanswer/server.env
ExecStart=/opt/finalanswer/bin/server
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
