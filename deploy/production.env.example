SERVER_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_PUBLIC_URL=https://play.example.com
SERVER_ALLOWED_ORIGINS=https://play.example.com
SERVER_TRUSTED_PROXY=127.0.0.1
SERVER_MAX_ROOMS=1000
JAVA_OPTS=-Xms256m -Xmx1g
# Connection limits for a cloud server (defaults 512 / 32 suit a home computer).
# Load test: 150 rooms x 7 sockets in the race = 26% of one core, ~580 MB RSS.
SERVER_MAX_PEERS=4000
# a whole party behind one Wi-Fi shares one public IP; leave room for a few parties in one venue
SERVER_MAX_PEERS_PER_IP=64
SERVER_UPGRADE_BURST=40
SERVER_UPGRADE_PER_SECOND=4
