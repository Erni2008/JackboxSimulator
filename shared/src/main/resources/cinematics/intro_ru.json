      "start": 53,
      "end": 68,
      "emotion": "DRAMATIC",
      "lines": [
        {
          "id": "intro_04_01",
          "text": "Правила просты!",
          "pauseAfter": 0.25,
          "subtitleText": "Правила просты!"
        },
        {
          "id": "intro_04_02",
          "text": "Я задаю вопросы — вы отвечаете.",
          "pauseAfter": 0.15,
          "subtitleText": "Я задаю вопросы — вы отвечаете."
        },
        {
          "id": "intro_04_03",
          "text": "За правильные ответы получаете преимущество.",
          "pauseAfter": 0.15,
          "subtitleText": "За правильные ответы получаете преимущество."
        },
        {
          "id": "intro_04_04",
          "text": "А за неправильные…",
          "pauseAfter": 0.7,
          "subtitleText": "А за неправильные…"
        },
        {
          "id": "intro_04_05",
          "text": "Вас ждут мои особенные испытания!",
          "pauseAfter": 0.5,
          "subtitleText": "Вас ждут мои особенные испытания!"
        }
      ],
