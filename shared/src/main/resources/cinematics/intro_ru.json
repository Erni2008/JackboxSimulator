    {
      "id": "greeting",
      "start": 9,
      "end": 23,
      "emotion": "SARCASTIC",
      "lines": [
        {
          "id": "intro_01_01",
          "text": "О, ну наконец-то!",
          "pauseAfter": 0.25,
          "subtitleText": "О, ну наконец-то!"
        },
        {
          "id": "intro_01_02",
          "text": "Проснулись, мои хорошие?",
          "pauseAfter": 0.65,
          "subtitleText": "Проснулись, мои хорошие?"
        },
        {
          "id": "intro_01_03",
          "text": "А я уж начал переживать.",
          "pauseAfter": 0.2,
          "subtitleText": "А я уж начал переживать."
        },
        {
          "id": "intro_01_04",
          "text": "Вы только посмотрите на себя… Сидите такие тихие, такие сладкие…",
          "pauseAfter": 0.25,
          "subtitleText": "Вы только посмотрите на себя… Сидите такие тихие, такие сладкие…"
        },
        {
          "id": "intro_01_05",
          "text": "Прямо загляденье!",
          "pauseAfter": 0.15,
          "subtitleText": "Прямо загляденье!"
        }
      ],
      "directions": [
        {
          "after": "intro_01_02",
          "type": "quiet_laugh",
          "file": "sounds/intro/host_quiet_laugh.wav"
        }
      ]
    },
    {
      "id": "hunter",
      "start": 23,
      "end": 38,
      "emotion": "DRAMATIC",
      "lines": [
        {
          "id": "intro_02_01",
          "text": "Точно.",
          "subtitleText": "Точно.",
          "emotion": "NEUTRAL",
          "pauseAfter": 0.25,
          "audioTailSeconds": 0.18
        },
        {
          "id": "intro_02_01b",
          "text": "Где же мои манеры?",
          "subtitleText": "Где же мои манеры?",
          "emotion": "SARCASTIC",
          "pauseAfter": 0.2,
          "audioTailSeconds": 0.18,
          "generation": {
            "seed": 3,
            "temperature": 0.8
          }
        },
        {
          "id": "intro_02_02",
          "text": "Я — охотник на паранормальные явления.",
          "pauseAfter": 0.15,
          "subtitleText": "Я — охотник на паранормальные явления."
        },
        {
          "id": "intro_02_03",
          "text": "Призраки, демоны, проклятые создания…",
          "pauseAfter": 0.55,
          "subtitleText": "Призраки, демоны, проклятые создания…"
        },
        {
          "id": "intro_02_04",
          "text": "Все вы — часть моей замечательной коллекции!",
          "pauseAfter": 0.45,
          "subtitleText": "Все вы — часть моей замечательной коллекции!"
        },
        {
          "id": "intro_02_05",
          "text": "И поверьте, поймать вас было непросто.",
          "pauseAfter": 0.15,
          "subtitleText": "И, поверьте, поймать вас было непросто."
        }
      ],
      "directions": [
        {
          "after": "intro_02_04",
          "type": "short_laugh",
          "file": "sounds/intro/host_short_laugh.wav"
        }
      ]
    },
    {
      "id": "offer",
      "start": 38,
      "end": 53,
      "emotion": "SINISTER",
      "lines": [
        {
          "id": "intro_03_01",
          "text": "Но знаете… Мне стало немного скучно.",
          "pauseAfter": 0.25,
          "subtitleText": "Но, знаете, мне стало немного скучно."
        },
        {
          "id": "intro_03_02",
          "text": "Поэтому я решил устроить небольшое соревнование!",
          "pauseAfter": 0.65,
          "subtitleText": "Поэтому я решил устроить небольшое соревнование!"
        },
        {
          "id": "intro_03_03",
          "text": "Победитель получит свободу.",
          "pauseAfter": 0.3,
          "subtitleText": "Победитель получит свободу."
        },
        {
          "id": "intro_03_04",
          "text": "Да! Один из вас действительно сможет выбраться отсюда!",
          "pauseAfter": 0.45,
          "subtitleText": "Да! Один из вас действительно сможет выбраться отсюда!"
        },
        {
          "id": "intro_03_05",
          "text": "А остальные…",
          "pauseAfter": 0.8,
          "subtitleText": "А остальные…"
        },
        {
          "id": "intro_03_06",
          "text": "Ну, не будем о грустном!",
          "pauseAfter": 0.15,
          "subtitleText": "Ну, не будем о грустном!"
        }
      ],
      "directions": [
        {
          "after": "intro_03_05",
